<% layout("/layouts/boilerplate") %>

<div class="airbnb-index-page">
    <% 
        // Helper to get formatted location/category title
        function getListingSubtitle(listing) {
            let type = "Home";
            const lowerTitle = (listing.title || "").toLowerCase();
            if (lowerTitle.includes("room")) type = "Room";
            else if (lowerTitle.includes("villa")) type = "Villa";
            else if (lowerTitle.includes("flat") || lowerTitle.includes("apt") || lowerTitle.includes("apartment") || lowerTitle.includes("loft")) type = "Flat";
            else if (lowerTitle.includes("cottage") || lowerTitle.includes("cabin")) type = "Cottage";
            
            return `${type} in ${listing.location || "India"}`;
        }

        // Helper to get rating string
        function getRating(listing, defaultRating) {
            if (listing.reviews && listing.reviews.length > 0) {
                let total = 0;
                listing.reviews.forEach(r => total += (r.rating || 5));
                return (total / listing.reviews.length).toFixed(2);
            }
            return defaultRating || "4.92";
        }

        // Group listings into sections
        const puducherryListings = allListings.filter(l => 
            (l.location && (l.location.toLowerCase().includes("puducherry") || l.location.toLowerCase().includes("pondicherry") || l.location.toLowerCase().includes("auroville")))
        );

        const yelagiriListings = allListings.filter(l => 
            (l.location && (l.location.toLowerCase().includes("yelagiri") || l.location.toLowerCase().includes("vellore")))
        );

        const keralaListings = allListings.filter(l => 
            (l.location && (l.location.toLowerCase().includes("thiruvananthapuram") || l.location.toLowerCase().includes("kerala") || l.location.toLowerCase().includes("kochi")))
        );

        // If specific collections are small, intelligently distribute allListings across sections
        let section1 = puducherryListings.length ? puducherryListings : allListings.slice(0, 7);
        let section2 = yelagiriListings.length ? yelagiriListings : allListings.slice(7, 14);
        let section3 = keralaListings.length ? keralaListings : allListings.slice(14, 21);
        let section4 = allListings.slice(21);

        // Titles & Subtitles matching Image 3
        const sec1Title = puducherryListings.length ? "Guest favourite homes in Puducherry" : "Guest favourite homes";
        const sec1Sub = puducherryListings.length ? "Indian guests often rate these homes highly" : "Guests often rate these homes highly";

        const sec2Title = yelagiriListings.length ? "Available in Yelagiri this weekend" : "Available this weekend";
        const sec2Sub = yelagiriListings.length ? "Hill town in Tamil Nadu with orchards" : "Popular spots for quick getaways";

        const sec3Title = keralaListings.length ? "Places to stay in Thiruvananthapuram" : "Trending destinations to stay";
        const sec3Sub = keralaListings.length ? "Kerala's capital with temple landmarks" : "Explore top rated stays across regions";
    %>

    <!-- Search / Filter Results Notice (if searched) -->
    <div id="noResultsNotice" class="d-none text-center py-5">
        <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
        <h3>No exact matches found</h3>
        <p class="text-muted">Try changing or clearing your search filter to see more listings.</p>
        <button class="btn btn-outline-dark rounded-pill px-4" onclick="clearSearchFilter()">View all listings</button>
    </div>

    <!-- Section 1 (Guest favourite homes) -->
    <% if(section1 && section1.length > 0) { %>
    <section class="listings-section" id="section-puducherry">
        <div class="section-header">
            <div class="section-header-text">
                <h2 class="section-title">
                    <a href="/listings?region=puducherry" class="section-title-link">
                        <%= sec1Title %> <span class="arrow-symbol">&rarr;</span>
                    </a>
                </h2>
                <p class="section-subtitle"><%= sec1Sub %></p>
            </div>
            <div class="section-nav-arrows d-none d-md-flex">
                <button class="carousel-arrow prev-btn" data-target="carousel-sec1" aria-label="Previous">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="carousel-arrow next-btn" data-target="carousel-sec1" aria-label="Next">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="listings-carousel" id="carousel-sec1">
            <% for(let i=0; i < section1.length; i++) { 
                let listing = section1[i];
                let rating = getRating(listing, (4.90 + (i % 10) * 0.01).toFixed(2));
                let cardTitle = getListingSubtitle(listing);
            %>
            <div class="listing-card-wrapper" data-location="<%= (listing.location || '').toLowerCase() %>" data-title="<%= (listing.title || '').toLowerCase() %>">
                <a href="/listings/<%= listing._id %>" class="airbnb-listing-card">
                    <div class="card-media-container">
                        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=60' %>" 
                             class="card-img" 
                             alt="<%= listing.title %>" 
                             loading="lazy" />
                        
                        <!-- Guest Favourite Pill Badge -->
                        <div class="badge-guest-favourite">
                            <span>Guest favourite</span>
                        </div>

                        <!-- Wishlist Heart Button -->
                        <button class="card-heart-btn" type="button" aria-label="Add to wishlist" onclick="toggleWishlist(event, this)">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>

                    <div class="card-info">
                        <div class="card-title-row">
                            <span class="card-title-text"><%= cardTitle %></span>
                        </div>
                        <div class="card-price-rating-row">
                            <span class="card-price-text">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '2,660' %></span>
                            <span class="card-unit-text">for 1 night</span>
                            <span class="card-dot">&middot;</span>
                            <span class="card-rating"><i class="fa-solid fa-star star-icon"></i> <%= rating %></span>
                        </div>
                    </div>
                </a>
            </div>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- Section 2 (Available in Yelagiri this weekend) -->
    <% if(section2 && section2.length > 0) { %>
    <section class="listings-section" id="section-yelagiri">
        <div class="section-header">
            <div class="section-header-text">
                <h2 class="section-title">
                    <a href="/listings?region=yelagiri" class="section-title-link">
                        <%= sec2Title %> <span class="arrow-symbol">&rarr;</span>
                    </a>
                </h2>
                <p class="section-subtitle"><%= sec2Sub %></p>
            </div>
            <div class="section-nav-arrows d-none d-md-flex">
                <button class="carousel-arrow prev-btn" data-target="carousel-sec2" aria-label="Previous">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="carousel-arrow next-btn" data-target="carousel-sec2" aria-label="Next">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="listings-carousel" id="carousel-sec2">
            <% for(let i=0; i < section2.length; i++) { 
                let listing = section2[i];
                let rating = getRating(listing, (4.85 + (i % 15) * 0.01).toFixed(2));
                let cardTitle = getListingSubtitle(listing);
            %>
            <div class="listing-card-wrapper" data-location="<%= (listing.location || '').toLowerCase() %>" data-title="<%= (listing.title || '').toLowerCase() %>">
                <a href="/listings/<%= listing._id %>" class="airbnb-listing-card">
                    <div class="card-media-container">
                        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=800&q=60' %>" 
                             class="card-img" 
                             alt="<%= listing.title %>" 
                             loading="lazy" />
                        
                        <!-- Guest Favourite Pill Badge -->
                        <% if(i % 2 === 0) { %>
                        <div class="badge-guest-favourite">
                            <span>Guest favourite</span>
                        </div>
                        <% } %>

                        <!-- Wishlist Heart Button -->
                        <button class="card-heart-btn" type="button" aria-label="Add to wishlist" onclick="toggleWishlist(event, this)">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>

                    <div class="card-info">
                        <div class="card-title-row">
                            <span class="card-title-text"><%= cardTitle %></span>
                        </div>
                        <div class="card-price-rating-row">
                            <span class="card-price-text">&#8377;<%= listing.price ? (listing.price * 2).toLocaleString("en-IN") : '18,000' %></span>
                            <span class="card-unit-text">for 2 nights</span>
                            <span class="card-dot">&middot;</span>
                            <span class="card-rating"><i class="fa-solid fa-star star-icon"></i> <%= rating %></span>
                        </div>
                    </div>
                </a>
            </div>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- Section 3 (Places to stay in Thiruvananthapuram / Kerala) -->
    <% if(section3 && section3.length > 0) { %>
    <section class="listings-section" id="section-kerala">
        <div class="section-header">
            <div class="section-header-text">
                <h2 class="section-title">
                    <a href="/listings?region=kerala" class="section-title-link">
                        <%= sec3Title %> <span class="arrow-symbol">&rarr;</span>
                    </a>
                </h2>
                <p class="section-subtitle"><%= sec3Sub %></p>
            </div>
            <div class="section-nav-arrows d-none d-md-flex">
                <button class="carousel-arrow prev-btn" data-target="carousel-sec3" aria-label="Previous">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="carousel-arrow next-btn" data-target="carousel-sec3" aria-label="Next">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="listings-carousel" id="carousel-sec3">
            <% for(let i=0; i < section3.length; i++) { 
                let listing = section3[i];
                let rating = getRating(listing, (4.88 + (i % 12) * 0.01).toFixed(2));
                let cardTitle = getListingSubtitle(listing);
            %>
            <div class="listing-card-wrapper" data-location="<%= (listing.location || '').toLowerCase() %>" data-title="<%= (listing.title || '').toLowerCase() %>">
                <a href="/listings/<%= listing._id %>" class="airbnb-listing-card">
                    <div class="card-media-container">
                        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=60' %>" 
                             class="card-img" 
                             alt="<%= listing.title %>" 
                             loading="lazy" />
                        
                        <div class="badge-guest-favourite">
                            <span>Guest favourite</span>
                        </div>

                        <!-- Wishlist Heart Button -->
                        <button class="card-heart-btn" type="button" aria-label="Add to wishlist" onclick="toggleWishlist(event, this)">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>

                    <div class="card-info">
                        <div class="card-title-row">
                            <span class="card-title-text"><%= cardTitle %></span>
                        </div>
                        <div class="card-price-rating-row">
                            <span class="card-price-text">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '3,200' %></span>
                            <span class="card-unit-text">for 1 night</span>
                            <span class="card-dot">&middot;</span>
                            <span class="card-rating"><i class="fa-solid fa-star star-icon"></i> <%= rating %></span>
                        </div>
                    </div>
                </a>
            </div>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- Section 4 (Additional Stays if any) -->
    <% if(section4 && section4.length > 0) { %>
    <section class="listings-section" id="section-more">
        <div class="section-header">
            <div class="section-header-text">
                <h2 class="section-title">
                    <a href="/listings" class="section-title-link">
                        Explore more unique places to stay <span class="arrow-symbol">&rarr;</span>
                    </a>
                </h2>
                <p class="section-subtitle">Comfortable homes and scenic retreats worldwide</p>
            </div>
        </div>

        <div class="listings-grid">
            <% for(let listing of section4) { 
                let rating = getRating(listing, "4.95");
                let cardTitle = getListingSubtitle(listing);
            %>
            <div class="listing-card-wrapper" data-location="<%= (listing.location || '').toLowerCase() %>" data-title="<%= (listing.title || '').toLowerCase() %>">
                <a href="/listings/<%= listing._id %>" class="airbnb-listing-card">
                    <div class="card-media-container">
                        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60' %>" 
                             class="card-img" 
                             alt="<%= listing.title %>" 
                             loading="lazy" />
                        
                        <div class="badge-guest-favourite">
                            <span>Guest favourite</span>
                        </div>

                        <button class="card-heart-btn" type="button" aria-label="Add to wishlist" onclick="toggleWishlist(event, this)">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>

                    <div class="card-info">
                        <div class="card-title-row">
                            <span class="card-title-text"><%= cardTitle %></span>
                        </div>
                        <div class="card-price-rating-row">
                            <span class="card-price-text">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '2,500' %></span>
                            <span class="card-unit-text">for 1 night</span>
                            <span class="card-dot">&middot;</span>
                            <span class="card-rating"><i class="fa-solid fa-star star-icon"></i> <%= rating %></span>
                        </div>
                    </div>
                </a>
            </div>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- Bottom Floating Tag Pill ("Prices include all fees") from Image 3 -->
    <div class="floating-tax-pill-container" id="taxPill">
        <div class="floating-tax-pill" role="button" tabindex="0">
            <span class="pill-tag-icon">🏷️</span>
            <span class="pill-text">Prices include all fees</span>
        </div>
    </div>
</div>
