<% layout("/layouts/boilerplate") %>

<div class="airbnb-auth-page">
    <div class="airbnb-auth-card">
        <div class="auth-card-header">
            <h2 class="auth-header-title">Log in</h2>
        </div>
        
        <div class="auth-card-body">
            <h3 class="auth-welcome-text">Welcome to Airbnb</h3>
            
            <form action="/login" method="POST" class="needs-validation auth-form" novalidate>
                <div class="mb-3">
                    <label for="username" class="airbnb-form-label">Username</label>
                    <input id="username" name="username" type="text" class="form-control airbnb-input" placeholder="Enter your username" required autofocus />
                    <div class="invalid-feedback">Please enter your username.</div>
                </div>

                <div class="mb-3">
                    <label for="password" class="airbnb-form-label">Password</label>
                    <input id="password" name="password" type="password" class="form-control airbnb-input" placeholder="Enter your password" required />
                    <div class="invalid-feedback">Please enter your password.</div>
                </div>

                <button class="btn btn-airbnb-primary w-100 py-3 fw-bold mt-2">
                    Continue
                </button>
            </form>

            <div class="auth-divider">
                <span>or</span>
            </div>

            <div class="auth-social-buttons">
                <button type="button" class="btn btn-outline-dark w-100 py-2 mb-2 rounded-3 d-flex align-items-center justify-content-center gap-2" onclick="alert('Google login is mock in demo mode')">
                    <i class="fa-brands fa-google text-danger"></i>
                    <span class="small fw-semibold">Continue with Google</span>
                </button>
                <button type="button" class="btn btn-outline-dark w-100 py-2 mb-2 rounded-3 d-flex align-items-center justify-content-center gap-2" onclick="alert('Apple login is mock in demo mode')">
                    <i class="fa-brands fa-apple"></i>
                    <span class="small fw-semibold">Continue with Apple</span>
                </button>
            </div>

            <p class="auth-switch-text text-center mt-3 mb-0">
                Don't have an account? <a href="/signup" class="fw-bold text-decoration-underline text-dark">Sign up</a>
            </p>
        </div>
    </div>
</div>
